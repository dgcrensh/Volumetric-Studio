# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must keep LF endings to run on Linux.
*.sh text eol=lf

# Project folders are checked byte for byte (their manifests list each blob's
# BLAKE3 hash), so line endings must never be converted.
**/*.vsproj/** -text

# Mesh files: STL may be binary or ASCII; either way keep the bytes.
*.stl -text
*.3mf binary
*.obj -text
